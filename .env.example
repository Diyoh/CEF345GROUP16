# Settings for docker compose. Copy to .env (start-docker.bat does this for you)
# and change the passwords. .env is gitignored; this example file is not.
#
# These only configure the local Docker stack. The backend's own settings
# (Cloudinary, CORS for deployments, and so on) live in Backend/.env.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=buildright_db1
MYSQL_USER=buildright_user
MYSQL_PASSWORD=change-me-app

# Login token secret for the local stack.
JWT_SECRET=local-docker-jwt-secret

# AI search (optional). With Ollama running on this computer, the backend
# container reaches it through host.docker.internal. Set AI_PROVIDER=none to turn it off.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:3b
OLLAMA_URL=http://host.docker.internal:11434

# Signs the financial ledger in the local stack. Any value works locally;
# production needs a long random one (see Backend/.env.example).
LEDGER_HMAC_KEY=local-docker-ledger-key
