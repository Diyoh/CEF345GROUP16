# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
DB_HOST=localhost
DB_USER=root
DB_PASS=your_password
DB_NAME=buildright
DB_PORT=3306
# Set to true for managed providers such as Aiven; automatically on when NODE_ENV=production
DB_SSL=false

# --- Auth ---
# With NODE_ENV=production the server refuses to start unless JWT_SECRET and
# LEDGER_HMAC_KEY are both set, at least 32 characters, not these example values,
# and different from each other. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key

# Signs every financial ledger entry (HMAC-SHA256). Must live outside the
# database and never rotate casually: past signatures verify against this key.
LEDGER_HMAC_KEY=set_a_long_random_value_here

# --- Limits (optional; sensible defaults applied when unset) ---
# Global requests per IP per 15 minutes. Credential routes are separately capped at 20
# failed attempts per 15 minutes and are not affected by this.
RATE_LIMIT_MAX=300
# Max JSON body size. Covers Base64 citizen-report photos; multipart uploads bypass it.
JSON_BODY_LIMIT=10mb
# Open-data API (/api/v1/public) requests per IP per 15 minutes. More generous than the app
# limit because bulk export is the point, but still bounded.
PUBLIC_API_RATE_LIMIT=120

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
# REQUIRED in production: when NODE_ENV=production, ONLY these origins are accepted
# (localhost defaults are not applied). Used by both the REST API and Socket.io.
# Example: CORS_ORIGINS=https://buildright.vercel.app,https://www.buildright.cm
CORS_ORIGINS=

# --- AI features (optional) ---
# none       off (default)
# ollama     a free open model on this machine: install https://ollama.com, then
#            ollama pull qwen2.5:3b
# anthropic  Claude through the Anthropic API (paid); set ANTHROPIC_API_KEY
# AI output is advisory only: it picks search filters and never changes a record.
AI_PROVIDER=none
# Model name for the chosen provider. Defaults: qwen2.5:3b (ollama), claude-opus-5-5 (anthropic)
AI_MODEL=
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
# Seconds matter on a laptop CPU; raise if a first request times out while the model loads.
AI_TIMEOUT_MS=60000
# AI searches per IP per 15 minutes
AI_RATE_LIMIT=30

# --- Image uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
